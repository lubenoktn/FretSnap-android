<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Hlavná obrazovka -->
    <LinearLayout
        android:id="@+id/mainPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Riffy"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:maxWidth="180dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingLeft="12dp"
                android:paddingTop="4dp"
                android:paddingRight="12dp"
                android:paddingBottom="4dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/helpButton"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:contentDescription="Návod"
                android:gravity="center"
                android:text="?"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/settingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Nastavenia"
                android:gravity="center"
                android:text="⚙"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:visibility="gone" />

        <sk.lubeno.riffy.LiveWaveView
            android:id="@+id/live"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:contentDescription="Priebeh zvuku za posledných 30 sekúnd" />

        <sk.lubeno.riffy.LevelView
            android:id="@+id/level"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="36dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/levelText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/gainText"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/gain"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/retro"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle"
                android:text="⟲\n30 s"
                android:textAllCaps="false"
                android:textSize="13sp" />

            <Button
                android:id="@+id/rec"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:background="@drawable/bg_rec"
                android:contentDescription="Nahrávať"
                android:text="●"
                android:textColor="#FFFFFF"
                android:textSize="36sp" />

            <Button
                android:id="@+id/tunerButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle"
                android:text="♪\nLadička"
                android:textAllCaps="false"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/recHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Ťuknutím zastavíte a uložíte"
            android:visibility="gone" />

        <Button
            android:id="@+id/markButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="📍 Značka"
            android:textAllCaps="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/recClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:textColor="#E53935"
            android:textSize="72sp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fillViewport="true"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/metroChip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/drumChip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/countChip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Odpočet"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/looperChip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="🔁 Looper"
                android:textSize="15sp" />
        </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/diaryText"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/tunerPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <sk.lubeno.riffy.TunerView
                android:id="@+id/tunerView"
                android:layout_width="match_parent"
                android:layout_height="170dp" />

            <TextView
                android:id="@+id/tunerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/looperPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <sk.lubeno.riffy.LoopView
                android:id="@+id/loopView"
                android:layout_width="match_parent"
                android:layout_height="96dp" />

            <TextView
                android:id="@+id/looperText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/looperBars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingRight="8dp"
                    android:text="Takty" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/looperMain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/looperUndo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Späť"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/looperMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:text="⋮"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/selectBar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/selectClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Zrušiť výber"
                    android:gravity="center"
                    android:text="✕"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/selectCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/selectFav"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Obľúbené"
                    android:gravity="center"
                    android:text="★"
                    android:textColor="#F9A825"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/selectShare"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Poslať" />

                <TextView
                    android:id="@+id/selectZip"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="ZIP" />

                <TextView
                    android:id="@+id/selectTest"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:text="Na test" />

                <TextView
                    android:id="@+id/selectDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Zmazať"
                    android:textColor="#E53935" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/filterRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_on"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="Všetky" />

                <TextView
                    android:id="@+id/filterFav"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="★ Obľúbené" />

                <TextView
                    android:id="@+id/filterSongs"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="🎵 Piesne" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/searchButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Hľadať"
                    android:gravity="center"
                    android:text="🔍"
                    android:textSize="18sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Názov, poznámka, tónina…"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:visibility="gone" />

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="#22808080"
                android:dividerHeight="1px" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="24dp"
                android:text="Zatiaľ tu nie sú žiadne riffy.\nNahrajte prvý veľkým červeným tlačidlom."
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:id="@+id/spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/noticeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/noticeAction"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="#90CAF9"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mini prehrávač -->
        <LinearLayout
            android:id="@+id/player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/playPause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="⏸&#xFE0E;"
                    android:textSize="22sp" />

                <LinearLayout
                    android:id="@+id/playerMain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/playerTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <ProgressBar
                        android:id="@+id/playerProgress"
                        style="@android:style/Widget.Material.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/playerInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="8dp"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/playerExpand"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Rozbaliť prehrávač"
                    android:gravity="center"
                    android:text="⌃"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/playerClose"
                    android:layout_width="40dp"
                    android:layout_height="44dp"
                    android:contentDescription="Zavrieť prehrávač"
                    android:gravity="center"
                    android:text="✕"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/playerMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <sk.lubeno.riffy.WaveView
                        android:id="@+id/playerWave"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:contentDescription="Priebeh nahrávky: ťuknutím skočíte, potiahnutím vyznačíte slučku" />

                    <TextView
                        android:id="@+id/playerTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="right"
                        android:minWidth="80dp"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="8dp"
                        android:text="Rýchlosť" />

                    <Spinner
                        android:id="@+id/speed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="44dp" />

                    <CheckBox
                        android:id="@+id/loop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dookola" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/playDrums"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="44dp" />

                    <TextView
                        android:id="@+id/markAdd"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip"
                        android:contentDescription="Pridať značku"
                        android:gravity="center"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="📍 +" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/markScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/markList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/loopA"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Začiatok ["
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/loopB"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Koniec ]"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/loopClear"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Celý"
                        android:textAllCaps="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/loopText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="8dp"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Nastavenia -->
    <ScrollView
        android:id="@+id/settingsPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/settingsBack"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:text="←  Nastavenia"
                android:textSize="22sp" />

            <TextView
                style="@style/Section"
                android:text="Vstup" />

            <Spinner
                android:id="@+id/inputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="Zdroj" />

                <Spinner
                    android:id="@+id/source"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="Formát" />

                <Spinner
                    android:id="@+id/format"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp" />

                <Spinner
                    android:id="@+id/channels"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/test"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nájsť nastavenie"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/usbInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Popis USB"
                    android:textAllCaps="false" />
            </LinearLayout>

            <TextView
                style="@style/Section"
                android:text="Nahrávanie" />

            <CheckBox
                android:id="@+id/trim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Orezať ticho na začiatku a konci" />

            <CheckBox
                android:id="@+id/normalize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zarovnať hlasitosť riffov" />

            <CheckBox
                android:id="@+id/autoRec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nahrávať automaticky, keď začnem hrať (a zastaviť po 4 s ticha)" />

            <CheckBox
                android:id="@+id/screenOn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Počas nahrávania nechať zapnutú obrazovku" />

            <CheckBox
                android:id="@+id/metroPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Metronóm a bicie do telefónu (inak do ToneX)" />

            <Button
                android:id="@+id/toneTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Skúšobný tón do ToneX"
                android:textAllCaps="false" />

            <TextView
                style="@style/Section"
                android:text="Vzhľad" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="Režim" />

                <Spinner
                    android:id="@+id/theme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="Farba" />

                <Spinner
                    android:id="@+id/accent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp" />
            </LinearLayout>

            <TextView
                style="@style/Section"
                android:text="Záloha" />

            <TextView
                android:id="@+id/backupInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/backupNew"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Zálohovať nové"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/backupAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Zálohovať všetko"
                    android:textAllCaps="false" />
            </LinearLayout>

            <TextView
                style="@style/Section"
                android:text="Aplikácia" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/version"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/manualButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Návod"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/updates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skontrolovať aktualizácie"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Návod -->
    <LinearLayout
        android:id="@+id/manualPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/manualBack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:text="←  Návod"
            android:textSize="22sp" />

        <WebView
            android:id="@+id/manual"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
